#define IDOK 1
#define IDCANCEL 2
#define DS_SETFONT 0x0040L
#define DS_MODALFRAME 0x0080L
#define WS_POPUP 0x80000000L
#define WS_CAPTION 0x00C00000L
#define WS_SYSMENU 0x00080000L
#define ES_AUTOHSCROLL 0x0080L

#define IDD_LANGUAGE_LABEL 101
#define IDC_LANGUAGE_NAME 1001
#define IDC_LABEL_EDIT 1002
#define IDC_USE_DEFAULT 1003

1 ICON "Resources\\app.ico"

IDD_LANGUAGE_LABEL DIALOGEX 0, 0, 220, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Language Label"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Language", IDC_LANGUAGE_NAME, 10, 9, 200, 12
    LTEXT           "Label (1-3 characters):", -1, 10, 27, 200, 10
    EDITTEXT        IDC_LABEL_EDIT, 10, 39, 200, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 38, 68, 50, 14
    PUSHBUTTON      "Use Default", IDC_USE_DEFAULT, 92, 68, 64, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 68, 50, 14
END
